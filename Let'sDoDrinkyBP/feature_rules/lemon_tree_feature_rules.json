{
  "format_version": "1.13.0",
  "minecraft:feature_rules": {
    "description": {
      "identifier": "karasichek:lemon_tree_feature_rules",
      "places_feature": "karasichek:lemon_tree"
    },
    "conditions": {
      "placement_pass": "surface_pass",
      "minecraft:biome_filter": [
        {
          "any_of": [
            {
              "test": "has_biome_tag",
              "operator": "==",
              "value": "plains"
            }
          ]
        }
      ]
    },
    "distribution": {
      "iterations": 1,
      "scatter_chance": "math.random(0,1) < 0.25 ? 1 : 0",
      
      "x": {
        "distribution": "uniform",
        "extent": [0, 8]
      },
      "y": "query.heightmap(variable.worldx, variable.worldz)",
      "z": {
        "distribution": "uniform",
        "extent": [0, 8]
      }
    }
  }
}